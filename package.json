{
  "name": "side-by-side-diff",
  "version": "0.2.0",
  "description": "Compare, review, and selectively merge two text files in Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run validate:manifest && npm run typecheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node scripts/validate-manifest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "esbuild": "0.25.5",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
