{
  "name": "side-by-side-diff",
  "version": "0.11.0",
  "description": "Compare notes and text files side by side. A Markdown diff viewer for file comparison, highlighting differences, and selectively merging changes.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "build": "npm run validate:manifest && npm run typecheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:e2e": "npm run build && node scripts/run-obsidian-tests.mjs ./wdio.conf.mts",
    "screenshots": "npm run build && node scripts/run-obsidian-tests.mjs ./wdio.screenshots.conf.mts",
    "screenshots:update": "npm run screenshots && node scripts/update-screenshots.mjs && npm run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e/tsconfig.json",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.17",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "globals": "^17.6.0",
    "obsidian": "latest",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1",
    "wdio-obsidian-service": "^3.5.0"
  }
}
